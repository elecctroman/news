RewriteEngine On

# Var olan dosya veya dizinleri doğrudan sun
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Kök isteği uygulamanın ön denetleyicisine yönlendirilir
RewriteRule ^$ public/index.php [L]

# Diğer tüm istekler public/ altına taşınır (ör. assets, uploads)
RewriteRule ^(.+)$ public/$1 [L]

# mod_rewrite kullanılamıyorsa ön denetleyiciyi yedek olarak çalıştır
FallbackResource /public/index.php
